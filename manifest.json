{
  "manifest_version": 3,
  "name": "CUIMS Auto Feedback",
  "version": "1.1.2",
  "description": "Automatically and intelligently detects, answers, and submits CUIMS feedback forms with customized responses.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.cuchd.in/*",
    "*://*.cuims.in/*",
    "*://cuchd.in/*",
    "*://cuims.in/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cuchd.in/*",
        "*://*.cuims.in/*",
        "*://cuchd.in/*",
        "*://cuims.in/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "file:///*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "config.js",
        "utils/detector.js",
        "utils/formParser.js",
        "utils/answerEngine.js",
        "utils/formFiller.js",
        "utils/submitVerifier.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CUIMS Auto Feedback Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
